rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Strict ownership rule: Each authenticated business owner can only read,
    // write, and delete documents inside their own users/{uid}/customers subcollection.
    match /users/{uid}/customers/{customerId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
